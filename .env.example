# ZORY AI Commerce Agent — configuration template.
# Copy to .env for local development. Every value is read through
# app/core/config.py; nothing else in the service reads the environment.
#
# Nesting uses "__":  ZORY_<GROUP>__<FIELD>

# local | test | stage | prod
ZORY_ENVIRONMENT=local
ZORY_SERVICE_NAME=zory-agent

# ── PostgreSQL (read-only against the Django-owned catalog) ──────────────────
# Must use the asyncpg driver; a blocking driver is rejected at startup.
ZORY_DB__DSN=postgresql+asyncpg://zory:zory@localhost:55432/zory
ZORY_DB__POOL_SIZE=10
ZORY_DB__MAX_OVERFLOW=5
ZORY_DB__POOL_TIMEOUT_S=10
ZORY_DB__POOL_RECYCLE_S=1800
ZORY_DB__CONNECT_TIMEOUT_S=10
ZORY_DB__COMMAND_TIMEOUT_S=15
ZORY_DB__ECHO_SQL=false
# Opens connections with default_transaction_read_only. Django owns every
# write to the catalog; leave this on.
ZORY_DB__READ_ONLY=true

# ── Redis ───────────────────────────────────────────────────────────────────
ZORY_REDIS__URL=redis://localhost:56379/0
ZORY_REDIS__CONNECT_TIMEOUT_S=2
ZORY_REDIS__SOCKET_TIMEOUT_S=2
ZORY_REDIS__MAX_CONNECTIONS=20

# ── Customer agent ──────────────────────────────────────────────────────────
# /v1/chat needs all three of these. Each has no default and none borrows
# another's: deciding a turn, wording the reply and designing a room are three
# jobs with three prompts, and sharing one identifier would make changing any
# of them change the others. With them unset the service still starts and
# serves /health, and /v1/chat answers "the customer agent is not configured".
# ZORY_CUSTOMER_AGENT__DECISION_MODEL=gpt-5.6-sol
# ZORY_CUSTOMER_AGENT__RESPONSE_MODEL=gpt-5.6-sol
# How many products one search may put in front of a customer. No default:
# the number decides how many options they see, so it is a deployment choice.
# ZORY_CUSTOMER_AGENT__PRESENTATION_LIMIT=5

# ── Interior design specialist ──────────────────────────────────────────────
# Optional. Without it the service sells furniture normally - searching,
# comparing, answering - and only whole-room requests find it missing.
# ZORY_INTERIOR_DESIGN__MODEL=gpt-5.6-sol

# ── Chat sessions (M13) ─────────────────────────────────────────────────────
# Short-term technical session lifetime only: not customer memory, not a
# billing period, not a commercial engagement window.
ZORY_SESSION__TTL_S=3600
# Prior messages carried into the next turn. Counted in messages, and even, so
# the window can always be met by whole user/assistant pairs. No summarisation.
ZORY_SESSION__MAX_HISTORY_MESSAGES=20
# Ceiling on one session read or write, once connected.
ZORY_SESSION__OPERATION_TIMEOUT_S=2.0

# ── API ─────────────────────────────────────────────────────────────────────
ZORY_API__PREFIX=/v1
ZORY_API__ENABLE_DOCS=true
# Explicit allowlist. "*" is rejected.
ZORY_API__CORS_ORIGINS=["http://localhost:3000"]

# ── Language model provider ─────────────────────────────────────────────────
# Used only for structured query understanding. The model name is required:
# nothing in the codebase carries a default model identifier.
ZORY_LLM__API_KEY=
ZORY_LLM__MODEL=gpt-5.6-sol
ZORY_LLM__TIMEOUT_S=60
ZORY_LLM__MAX_RETRIES=2
# Reasoning models: set the effort, and leave TEMPERATURE unset - they reject it.
ZORY_LLM__REASONING_EFFORT=medium
# Non-reasoning models (e.g. gpt-4.1-mini): set TEMPERATURE=0 for repeatable
# extraction, and leave REASONING_EFFORT unset.
# ZORY_LLM__TEMPERATURE=0

# ── Semantic ranking (M9) ───────────────────────────────────────────────────
# Optional. With no Pinecone configured the service still starts and returns
# deterministic results; semantic ranking simply does not run.
# The embedding model is required for semantic ranking and has no default:
# nothing in the codebase carries a model identifier.
ZORY_LLM__EMBEDDING_MODEL=text-embedding-3-large
# Namespace is derived by application code from RetailerContext, never from a
# customer message or model output. Must contain {store_id}.
# ZORY_PINECONE__NAMESPACE_TEMPLATE=store-{store_id}
# Both are required together for semantic ranking, and left unset here on
# purpose: an empty API key is not "no Pinecone", it is a configured client
# that cannot authenticate. Quote nothing - the value is read literally.
# ZORY_PINECONE__API_KEY=
# ZORY_PINECONE__INDEX_NAME=ai-agent

# ── Product discovery ───────────────────────────────────────────────────────
# Bounds on the candidate pool handed to later ranking. Never a bulk export.
ZORY_DISCOVERY__DEFAULT_CANDIDATE_LIMIT=50
ZORY_DISCOVERY__MAX_CANDIDATE_LIMIT=200

# ── Observability ───────────────────────────────────────────────────────────
ZORY_OBSERVABILITY__LOG_LEVEL=INFO
# json in deployed environments; console is easier to read locally.
ZORY_OBSERVABILITY__LOG_FORMAT=console
ZORY_OBSERVABILITY__TRACE_HEADER=X-Request-ID

# ── AWS Secrets Manager (stage/prod only) ───────────────────────────────────
# When ZORY_ENVIRONMENT is stage or prod, secret material is loaded from this
# secret as JSON shaped like the settings tree, e.g.
#   {"db": {"dsn": "..."}, "redis": {"url": "..."}}
# Unused locally; boto3 is never imported outside stage/prod.
ZORY_AWS__REGION=me-south-1
ZORY_AWS__SECRET_NAME=