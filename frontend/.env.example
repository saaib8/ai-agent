# ── Production: backend URL baked into the build ──────────────────────────────
# Set this before `npm run build` to point the app at your backend. It becomes
# the default API base URL in the built bundle. Leave it UNSET to call the API
# same-origin (recommended: serve dist/ behind a reverse proxy that forwards
# /v1 and /health to the FastAPI service — no CORS needed).
# If you set an absolute cross-origin URL here, enable CORS on the backend
# (ZORY_API__CORS_ORIGINS) for the frontend's origin.
# VITE_API_BASE_URL=https://api.zory.ai

# ── Development only: Vite dev-server proxy target ────────────────────────────
# Where `npm run dev` forwards /v1 and /health. Not used in production builds.
VITE_PROXY_TARGET=http://localhost:8000
