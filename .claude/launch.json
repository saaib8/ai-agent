{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--all-extras",
        "uvicorn",
        "app.main:create_app",
        "--factory",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000,
      "env": {
        "VITE_PROXY_TARGET": "http://localhost:8001"
      }
    }
  ]
}
